+
+/* ==========================================================================
+   Space theme
+   Pairs with starfield.js, which drops a <canvas class="sky"> into each
+   section. To remove the whole effect: delete starfield.js, its <script>
+   tag, and this block.
+   ========================================================================== */
+
+/* each sky lives behind its section's content, inside the section's own
+   stacking context */
+.has-sky { position: relative; isolation: isolate; }
+.sky {
+  position: absolute; inset: 0; width: 100%; height: 100%;
+  z-index: -1; pointer-events: none; display: block;
+}
+@media print { .sky { display: none; } }
+
+/* ---------- night-sky hero ---------- */
+/* full-bleed wrapper so the sky and nebula run edge to edge */
+.hero-wrap { overflow: hidden; background-color: var(--ink); background-image: linear-gradient(180deg, #091320 0%, var(--ink) 100%); }
+/* slow-moving nebula glow behind the stars. transform-only, so it is cheap */
+.hero-wrap::before {
+  content: ""; position: absolute; inset: -18% -8%; z-index: -1; pointer-events: none;
+  background:
+    radial-gradient(38% 44% at 82% 30%, rgba(240, 166, 59, 0.13), transparent 70%),
+    radial-gradient(44% 50% at 10% 80%, rgba(96, 128, 214, 0.17), transparent 70%),
+    radial-gradient(30% 34% at 52% 6%, rgba(150, 110, 220, 0.09), transparent 70%);
+  animation: nebula-drift 42s ease-in-out infinite alternate;
+}
+@keyframes nebula-drift {
+  from { transform: translate3d(-2.5%, 1%, 0) scale(1); }
+  to   { transform: translate3d(2.5%, -3%, 0) scale(1.08); }
+}
+.hero-gauge { overflow: visible; }
+.hero-gauge-fill { filter: drop-shadow(0 0 12px rgba(240, 166, 59, 0.38)); }
+
+/* faint colour washes so the long dark page has some variety instead of one flat slab.
+   each one is centred vertically and fades to zero before it reaches the section's
+   top or bottom edge (radius < 50% of height), so there are never any visible seams */
+.about      { background: radial-gradient(45% 40% at 6% 50%,  rgba(96, 128, 214, 0.11), transparent 100%), var(--ink); }
+.experience { background: radial-gradient(45% 40% at 94% 50%, rgba(240, 166, 59, 0.08), transparent 100%), var(--ink); }
+.skills     { background: radial-gradient(45% 40% at 94% 50%, rgba(150, 110, 220, 0.11), transparent 100%), var(--ink); }
+.contact    { background: radial-gradient(50% 42% at 50% 50%, rgba(240, 166, 59, 0.10), transparent 100%), var(--ink); }
